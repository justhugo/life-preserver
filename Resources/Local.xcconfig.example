// Copy to Local.xcconfig and replace these examples with your own settings.
// Local.xcconfig is ignored by Git. The same cloud container serves both apps.
LP_DEVELOPMENT_TEAM = YOURTEAMID
LP_MAC_BUNDLE_IDENTIFIER = com.yourname.lifepreserver.mac
LP_MOBILE_BUNDLE_IDENTIFIER = com.yourname.lifepreserver.mobile
LP_CLOUD_CONTAINER_IDENTIFIER = iCloud.com.yourname.lifepreserver
